static void dispatch_command(const char *command) {
    if (command[0] == '\0') {
        return;
    }

    if (str_equals(command, "help") || starts_with(command, "help ")) {
        cmd_help();
        return;
    }
    if (str_equals(command, "whoami")) {
        cmd_whoami();
        return;
    }
    if (str_equals(command, "ls")) {
        cmd_ls();
        return;
    }
    if (str_equals(command, "cat")) {
        cmd_cat();
        return;
    }
    if (str_equals(command, "sysinfo")) {
        cmd_sysinfo();
        return;
    }
    if (str_equals(command, "theme")) {
        cmd_theme();
        return;
    }
    if (str_equals(command, "apps")) {
        cmd_apps();
        return;
    }
    if (str_equals(command, "scan")) {
        cmd_scan();
        return;
    }
    if (str_equals(command, "install")) {
        cmd_install();
        return;
    }
    if (str_equals(command, "clear")) {
        cmd_clear();
        return;
    }
    if (str_equals(command, "reboot")) {
        cmd_reboot();
        return;
    }

    print("Unknown command. Run 'help' for system commands.\n");
}

