#!/bin/sh
if [ "$#" -eq 0 ]; then
    echo "Neon OS System Control\n"
    echo "Usage: neonctl {status|apps|repo|version}\n"
    exit 0
fi

case "$1" in
    status)
        echo "System state: running\n"
        echo "Kernel: bare-metal prototype\n"
        echo "Shell: neon-shell\n"
        ;;
    apps)
        echo "Installed apps: theme-studio, terminal-boost, file-guardian\n"
        ;;
    repo)
        echo "Repositories: core, apps\n"
        ;;
    version)
        echo "Neon OS 0.4\n"
        ;;
    *)
        echo "Unknown command: $1";
        exit 2;
        ;;
 esac
